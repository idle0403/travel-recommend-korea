# 🐳 AWS Lambda용 Docker 이미지 (Redis 포함)
# Python 3.13 + FastAPI + Redis + Lambda Runtime Interface Client

FROM public.ecr.aws/lambda/python:3.13

# 작업 디렉토리 설정
WORKDIR ${LAMBDA_TASK_ROOT}

# 시스템 패키지 설치 (Python 패키지 빌드용)
# Lambda Python 베이스 이미지는 Amazon Linux 2023 기반 (microdnf 사용)
RUN if command -v microdnf > /dev/null; then \
        microdnf install -y \
        gcc \
        gcc-c++ \
        libxml2-devel \
        libxslt-devel \
        && microdnf clean all; \
    elif command -v yum > /dev/null; then \
        yum update -y && \
        yum install -y \
        gcc \
        gcc-c++ \
        libxml2-devel \
        libxslt-devel \
        && yum clean all; \
    elif command -v apt-get > /dev/null; then \
        apt-get update && \
        apt-get install -y \
        gcc \
        g++ \
        libxml2-dev \
        libxslt1-dev \
        && apt-get clean && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Redis는 외부 서비스로 사용 (Lambda 내부에 설치하지 않음)
# REDIS_HOST, REDIS_PORT 환경 변수로 외부 Redis 연결

# Python 의존성 파일 복사
COPY requirements.txt .

# Python 패키지 설치 (Lambda용 추가 패키지 포함)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 애플리케이션 코드 복사
COPY app/ ${LAMBDA_TASK_ROOT}/app/
# 프론트엔드 파일 복사 (정적 파일 서빙을 위해 필요)
COPY frontend/ ${LAMBDA_TASK_ROOT}/frontend/

# Redis는 외부 서비스로 사용 (시작 스크립트 불필요)

# Lambda 핸들러 설정
# Mangum을 사용하여 FastAPI 앱을 Lambda 핸들러로 래핑
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV REDIS_URL=redis://localhost:6379/0
ENV REDIS_HOST=localhost
ENV REDIS_PORT=6379

# Lambda 핸들러 함수
CMD ["app.lambda_handler.handler"]
